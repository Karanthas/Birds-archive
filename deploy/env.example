# 专用空根初始化与日常只读核验；生产TLS材料与IP须明确配置。
# 全部宿主路径必须预先存在。不得引用私人图库或把旧评测根改为生产根。
BIRDS_PROJECT=
BIRDS_APP_IMAGE=
BIRDS_BASE_IMAGE=
BIRDS_BASE_IMAGE_ID=
BIRDS_PYTHON_TREE_SHA=
BIRDS_SOURCE_SHA=
BIRDS_UID=
BIRDS_GID=
BIRDS_DEPLOYMENT_ID=
BIRDS_SECRET_KEY=
BIRDS_ALLOWED_HOSTS=
BIRDS_PROXY_ONLY=1
# 两个不同的精确DNS名，ALLOWED_HOSTS必须恰好包含这两个名称。
BIRDS_LAN_HOST=
BIRDS_REMOTE_HOST=
# 精确宿主IP；实验只能用移除ports的专用override，不发布宿主端口。
BIRDS_LAN_IP=
BIRDS_REMOTE_IP=
# LAN目录含server.crt/server.key；remote另含client-ca.crt/clients.crl。
# 不挂载CA私钥、设备私钥或其他NAS目录。
# 官方模板直接渲染到已存在且可写的/tmp/nginx.conf，不依赖新子目录。
BIRDS_LAN_TLS_DIR=
BIRDS_REMOTE_TLS_DIR=
BIRDS_LOCAL_HTTP=0
BIRDS_DEPLOYMENT_MEMORY_MB=2048
BIRDS_DEPLOYMENT_RESERVE_MB=512
# 合计常驻2CPU/2048MiB；worker含既有256MiB余量，实验关闭模型。
BIRDS_WEB_MEMORY=512m
BIRDS_WEB_CPUS=0.5
BIRDS_WORKER_MEMORY=1280m
BIRDS_WORKER_CPUS=1.2
BIRDS_PROXY_MEMORY=128m
BIRDS_PROXY_CPUS=0.15
# 此专用父目录下必须预建inbox/data/archive/claim四个隔离子根。
# 父目录root:root/0711；四子根归应用UID且0700，元配置仍root/0600。
BIRDS_ROOTS_HOST=
