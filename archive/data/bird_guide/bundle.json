      "similar_species": [
        {
          "target_concept": "avibase:DE21A6BE0D3EE1AD:avilist-2025:v1",
          "editorial_order": 1,
          "current_text": "成年雄鸟背部红色、喙红色；成年雌鸟体色较褐，喙为红色锥形。",
          "target_text": "成年雄鸟背部灰色、喙黄色；成年雌鸟体色较灰，喙黄色、粗短而圆，近似鹦鹉喙。",
          "limitations": "以上比较限成年雌雄鸟；幼鸟可能有暗色喙，不能套用成鸟的喙色规则。地域与季节不能单独确证物种；图片仅为所示个体，不代表所有年龄、性别或季节。",
          "source_ids": [
            "avibase-4E74AE22-appearance",
            "avibase-DE21A6BE-appearance",
            "avibase-4E74AE22-comparison-introduction"
          ],
          "fact_check_url": "https://www.allaboutbirds.org/guide/Pyrrhuloxia/species-compare"
        }
      ],
      "reference_assets": [
        {
          "public_file_id": "File:Northern_Cardinal_Male-27527.jpg",
          "author": "Ken Thomas",
          "license": "公有领域（PD-self；备用无条件使用授权）",
          "license_url": "https://commons.wikimedia.org/wiki/File:Northern_Cardinal_Male-27527.jpg#Licensing",
          "source_url": "https://commons.wikimedia.org/w/index.php?title=File:Northern_Cardinal_Male-27527.jpg&oldid=1005957106",
          "original_source_url": "https://www.kenthomas.us/",
          "acquired_at": "2026-10-26",
          "change_note": "原图字节保存，未裁切、未重新编码；布局等比例完整显示。",
          "relative_key": "assets/northern-cardinal.jpg",
          "sha256": "3bcd092d0f3d45799cefbb168532183a6074a465887c30c91b67e7b529829407",
          "mime": "image/jpeg",
          "size": 406823,
          "width": 1000,
          "height": 1200,
          "alt": "北美红雀成年雄鸟，枝间栖立的侧前方视角",
          "download_url": "https://upload.wikimedia.org/wikipedia/commons/8/83/Northern_Cardinal_Male-27527.jpg"
        }
      ],
      "summary": {
        "text": "北美红雀是一种具有明显冠羽和粗壮喙的鸣禽，成年雌雄羽色不同。它栖居于北美洲的林地、花园、灌丛和湿地等环境。",
        "source_ids": [
          "avibase-4E74AE22-appearance",
          "avibase-4E74AE22-habits",
          "avibase-4E74AE22-distribution"
        ]
      },
      "appearance": {
        "text": "成年雄鸟鲜红，眼周至上胸有黑色面罩，背和翅颜色稍暗；成年雌鸟以灰褐色为主，翅、冠和尾带红色。雌雄成鸟都有明显冠羽和强壮的珊瑚色锥形喙；幼鸟羽色较近似雌鸟，不能套用成年雄鸟的全红特征。",
        "source_ids": [
          "avibase-4E74AE22-appearance"
        ]
      },
      "habits": {
        "text": "成鸟主要吃草籽、谷物及果实，也取食昆虫等；常在地面跳跃寻找食物，雏鸟几乎全由昆虫喂养。雄鸟以鸣唱等行为保卫领地。",
        "source_ids": [
          "avibase-4E74AE22-habits",
          "avibase-4E74AE22-habits-Behavior"
        ]
      },
      "distribution": {
        "text": "原生分布包括加拿大东南部、美国东部及西南部部分地区，向南经过墨西哥到危地马拉和伯利兹北部。栖息于林地、花园、灌丛及湿地；百慕大和夏威夷有引入种群。",
        "source_ids": [
          "avibase-4E74AE22-distribution"
        ]
      }
    },
