      "similar_species": [],
      "reference_assets": [],
      "summary": {
        "text": "大白鹭是一种羽毛全白的大型鹭鸟，广布于温带与热带地区。它在浅水等生境觅食，并在近水的树上集群营巢。",
        "source_ids": [
          "avibase-49D9148A-appearance",
          "avibase-49D9148A-habits",
          "avibase-49D9148A-distribution"
        ]
      },
      "appearance": {
        "text": "全身白色，通常可见黄色喙及黑色腿脚；繁殖季喙可能变深、腿下部变浅，背部有纤细的饰羽。雌雄外观相似，幼鸟近似非繁殖期成鸟。飞行缓慢，颈部收缩。",
        "source_ids": [
          "avibase-49D9148A-appearance"
        ]
      },
      "habits": {
        "text": "在浅水或较干燥的生境觅食，食物包括鱼、蛙等两栖动物、小鼠、蛇、螯虾及昆虫。繁殖时常在大湖、芦苇地或其他大片湿地附近的树上集群筑巢，雌雄共同孵卵和育雏。",
        "source_ids": [
          "avibase-49D9148A-habits"
        ]
      },
      "distribution": {
        "text": "按此资料采用的广义范围，分布横跨美洲、非洲、欧洲和亚洲的温带与热带地区；modesta亚种分布于亚洲及大洋洲。不同分类可能拆分美洲或东方种群，本介绍沿用AviList 2025的整体物种范围。",
        "source_ids": [
          "avibase-49D9148A-distribution",
          "avibase-49D9148A-distribution-Subspecies"
        ]
      }
    },
